# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and should travel with the repo.
!.env.example

# Supabase: the local CLI folder, and SQL kept out of the repo
/supabase
*.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Scratch dist dir for builds run alongside a live dev server
.next-verify

# Local waitlist captured by the dev fallback in /api/notify
.notify-signups.json
.next-dev-scratch
