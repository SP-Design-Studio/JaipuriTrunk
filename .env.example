# Waitlist destinations. Both are optional and independent — with neither set
# the form still works and signups are logged to the server console.

# --- Supabase: the durable list -------------------------------------------
# Project settings -> API. The SERVICE ROLE key bypasses row-level security,
# so it must never be exposed to the browser. It is read only in the route
# handler, which runs on the server.
#
# Create the table once by running supabase/waitlist.sql in the SQL editor.
# That file is deliberately gitignored, so it is on the dev machine only and
# will not be in a fresh clone. It creates a `waitlist` table, a unique index on
# lower(email) — which is what makes a repeat signup a no-op rather than a
# duplicate row — and enables row-level security with no policies, so only the
# service role can read the list.
#
# SUPABASE_URL is the Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend: a note to you per signup -------------------------------------
# NOTIFY_EMAIL_FROM must be on a domain you have verified with Resend.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
